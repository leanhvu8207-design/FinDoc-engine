# ============================================================================
# FinDoc-Engine Environment Configuration
# ============================================================================

# Application Settings
APP_NAME=FinDoc-Engine
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# AI Model Settings
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
VECTOR_DIM=768
MODEL_DEVICE=cpu

# Chunking & Parsing Settings
CHUNK_SIZE=1024
CHUNK_OVERLAP=128
MAX_TABLE_ROWS_PER_CHUNK=100

# Qdrant Vector Database Settings
# Set QDRANT_USE_LOCAL=true when running without Docker (stores in QDRANT_LOCAL_PATH)
# Set QDRANT_USE_LOCAL=false when running Qdrant via docker-compose (http://localhost:6333)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=financial_documents
QDRANT_USE_LOCAL=true
QDRANT_LOCAL_PATH=./data/qdrant_storage

# LLM Settings (Gemini API for Phase 4 synthesis)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-flash

# DuckDB & Sparse Index Settings
DUCKDB_PATH=./data/duckdb/findoc.duckdb
BM25_INDEX_PATH=./data/processed/bm25_index.pkl

# Hybrid Search & Guardrail Settings
RRF_K=60
DEFAULT_TOP_K=5
RERANK_TOP_K=20
NUMERIC_TOLERANCE=1e-4
